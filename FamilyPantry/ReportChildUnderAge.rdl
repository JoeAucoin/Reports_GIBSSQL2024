  <DataSources>
    <DataSource Name="inetDNN_FamilyPantry">
      <ConnectionProperties>
        <DataProvider>SQLAZURE</DataProvider>
        <ConnectString>Data Source=gibs.database.windows.net;Initial Catalog=inetDNN_FamilyPantry</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>844cfca6-0d30-4672-b47c-70fa71a75e9b</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>inetDNN_FamilyPantry</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MaxAge">
            <Value>=Parameters!MaxAge.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT 
                      GIBS_FBClients.ClientID, GIBS_FBClients.ClientFirstName + ' ' + GIBS_FBClients.ClientLastName AS ClientFullName, GIBS_FBClients.ClientLastName, 
                      UPPER(GIBS_FBClients.ClientCity) AS ClientCity, UPPER(GIBS_FBClients.ClientTown) AS ClientTown, GIBS_FBClients.ClientZipCode, 

					   CAST
                          ((SELECT     COUNT([dbo].[fn_GIBS_FBClients_GetAge](ClAddFamMemDOB, GETDATE())) AS Expr1
                              FROM         dbo.GIBS_FBClientsAddFamMem
                              WHERE     (dbo.GIBS_FBClientsAddFamMem.ClientID = dbo.GIBS_FBClients.ClientID) AND ([dbo].[fn_GIBS_FBClients_GetAge](ClAddFamMemDOB, GetDate()) &lt;= @MaxAge)) 
							  
							  AS INT) AS AFM_UnderOrEqualToMaxAge
                    
FROM         GIBS_FBClients  LEFT OUTER JOIN
                      GIBS_FBClientsVisits ON GIBS_FBClients.ClientID = GIBS_FBClientsVisits.ClientID
WHERE     (GIBS_FBClientsVisits.VisitDate BETWEEN CONVERT(DATETIME, @StartDate, 102) AND CONVERT(DATETIME, @EndDate, 102))  AND CAST
                          ((SELECT     COUNT([dbo].[fn_GIBS_FBClients_GetAge](ClAddFamMemDOB, GETDATE())) AS Expr1
                              FROM         dbo.GIBS_FBClientsAddFamMem
                              WHERE     (dbo.GIBS_FBClientsAddFamMem.ClientID = dbo.GIBS_FBClients.ClientID) AND ([dbo].[fn_GIBS_FBClients_GetAge](ClAddFamMemDOB, GetDate()) &lt;= @MaxAge)) 
							  
							  AS INT) &gt; 0
                   
ORDER BY GIBS_FBClients.ClientID</CommandText>
      </Query>
      <Fields>
        <Field Name="ClientID">
          <DataField>ClientID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ClientFullName">
          <DataField>ClientFullName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ClientLastName">
          <DataField>ClientLastName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ClientCity">
          <DataField>ClientCity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ClientTown">
          <DataField>ClientTown</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ClientZipCode">
          <DataField>ClientZipCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="AFM_UnderOrEqualToMaxAge">
          <DataField>AFM_UnderOrEqualToMaxAge</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
