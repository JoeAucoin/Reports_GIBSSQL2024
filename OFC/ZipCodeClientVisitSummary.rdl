    <DataSet Name="ServiceLocations">
      <Query>
        <DataSourceName>inetDNN_OFC</DataSourceName>
        <CommandText>SELECT        '0' AS Value, 'All Visits' AS Text
UNION ALL
SELECT        'Pantry' AS Value, 'Pantry Visit' AS Text
UNION ALL
SELECT        Value, Text
FROM            Lists
WHERE        (ListName = 'ClientServiceLocation')  </CommandText>
      </Query>
